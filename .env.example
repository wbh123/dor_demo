# 武汉科技大学学生宿舍智能选择系统本地运行配置模板
# 使用方式：cp .env.example .env
# 根目录 .env 不得提交版本库。

# ---------- 通用 ----------
WUST_DORMITORY_TIMEZONE=Asia/Shanghai
WUST_DORMITORY_SERVER_PORT=8080

# ---------- MySQL ----------
WUST_DORMITORY_MYSQL_IMAGE=mysql:8.4
WUST_DORMITORY_DB_HOST=localhost
WUST_DORMITORY_DB_PORT=3306
WUST_DORMITORY_DB_NAME=wust_dormitory
WUST_DORMITORY_DB_USER=wust_dormitory_dev
WUST_DORMITORY_DB_PASSWORD=请替换为数据库密码
WUST_DORMITORY_DB_ROOT_PASSWORD=请替换为数据库根密码

# Flyway 默认只执行正式结构迁移。
# 本地首次需要测试数据时，可改为：
# classpath:db/migration,filesystem:backend-java/server/src/test/resources/db/dev-migration
WUST_DORMITORY_FLYWAY_LOCATIONS=classpath:db/migration

# ---------- Redis ----------
WUST_DORMITORY_REDIS_IMAGE=redis:7.4-alpine
WUST_DORMITORY_REDIS_HOST=localhost
WUST_DORMITORY_REDIS_PORT=6379
WUST_DORMITORY_REDIS_PASSWORD=请替换为Redis密码
