# 公开开发环境变量模板
# 使用方式：复制为 .env 后填写本地值；.env 不得提交。

# ---------- 展示信息（虚构，可统一替换） ----------
WUST_DORMITORY_INSTITUTION_NAME=示例大学
WUST_DORMITORY_CAMPUS_NAME=示例校区
VITE_INSTITUTION_NAME=示例大学
VITE_CAMPUS_NAME=示例校区
VITE_APP_TITLE=示例大学选寝
VITE_APP_SUBTITLE=宿舍智能选择系统
VITE_ADMIN_CONTACT_PHONE=000-0000-0000
VITE_OPERATOR_NAME=运营单位信息待填写
VITE_ICP_RECORD=ICP备案信息待填写

# ---------- 通用 ----------
WUST_DORMITORY_TIMEZONE=Asia/Shanghai
WUST_DORMITORY_SERVER_PORT=8080
WUST_DORMITORY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# ---------- 前端开发服务器 ----------
VITE_DEV_SERVER_PORT=5174
VITE_BACKEND_PROXY_TARGET=http://localhost:8080
# 多个域名使用英文逗号分隔；留空时仅使用Vite默认允许的本机地址。
VITE_ALLOWED_HOSTS=

# ---------- MySQL（仅本地占位，不包含结构脚本） ----------
WUST_DORMITORY_DB_HOST=localhost
WUST_DORMITORY_DB_PORT=3306
WUST_DORMITORY_DB_NAME=wust_dormitory
WUST_DORMITORY_DB_USER=local_user
WUST_DORMITORY_DB_PASSWORD=change-me

# ---------- Redis ----------
WUST_DORMITORY_REDIS_HOST=localhost
WUST_DORMITORY_REDIS_PORT=6379
WUST_DORMITORY_REDIS_PASSWORD=change-me
