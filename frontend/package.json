{
  "name": "wust-dormitory-select-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../backend-java/model/src/main/resources/openapi-interface.yaml -o src/api/schema.d.ts",
    "predev": "npm run generate:api",
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "npm run generate:api && vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "pinia": "^3.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
