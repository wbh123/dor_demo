<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <properties resource="mybatis-generator/generator.properties"/>

    <context id="defaultContext" targetRuntime="MyBatis3">
        <property name="autoDelimitKeywords" value="true"/>
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>
        <property name="useJSR310Types" value="true"/>

        <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin"/>
        <plugin type="org.mybatis.generator.plugins.UnmergeableXmlMappersPlugin"/>

        <commentGenerator>
            <property name="suppressAllComments" value="false"/>
            <property name="suppressDate" value="true"/>
            <property name="addRemarkComments" value="true"/>
            <property name="javaFileEncoding" value="UTF-8"/>
        </commentGenerator>

        <jdbcConnection
                driverClass="${driverClassName}"
                connectionURL="${url}"
                userId="${username}"
                password="${password}">
            <property name="nullCatalogMeansCurrent" value="true"/>
        </jdbcConnection>

        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <javaModelGenerator targetPackage="com.wust.dormitory.pojo.po" targetProject="MAVEN">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <sqlMapGenerator targetPackage="com/wust/dormitory/mappers/" targetProject="MAVEN">
            <property name="enableSubPackages" value="false"/>
        </sqlMapGenerator>

        <javaClientGenerator type="XMLMAPPER" targetPackage="com.wust.dormitory.mapper" targetProject="MAVEN">
            <property name="enableSubPackages" value="false"/>
        </javaClientGenerator>

        <table tableName="organization" domainObjectName="OrganizationEntity"/>
        <table tableName="app_user" domainObjectName="AppUserEntity"/>
        <table tableName="campus" domainObjectName="CampusEntity"/>
        <table tableName="student" domainObjectName="StudentEntity"/>
        <table tableName="dormitory_building" domainObjectName="DormitoryBuildingEntity"/>
        <table tableName="dormitory_floor" domainObjectName="DormitoryFloorEntity"/>
        <table tableName="room" domainObjectName="RoomEntity"/>
        <table tableName="bed_frame" domainObjectName="BedFrameEntity"/>
        <table tableName="bed" domainObjectName="BedEntity"/>
        <table tableName="selection_batch" domainObjectName="SelectionBatchEntity"/>
        <table tableName="batch_student_eligibility" domainObjectName="BatchStudentEligibilityEntity"/>
        <table tableName="questionnaire_version" domainObjectName="QuestionnaireVersionEntity"/>
        <table tableName="questionnaire_question" domainObjectName="QuestionnaireQuestionEntity"/>
        <table tableName="questionnaire_option" domainObjectName="QuestionnaireOptionEntity"/>
        <table tableName="questionnaire_answer" domainObjectName="QuestionnaireAnswerEntity"/>
        <table tableName="student_feature" domainObjectName="StudentFeatureEntity"/>
        <table tableName="matching_weight_scheme" domainObjectName="MatchingWeightSchemeEntity"/>
        <table tableName="selection_team" domainObjectName="SelectionTeamEntity"/>
        <table tableName="selection_team_member" domainObjectName="SelectionTeamMemberEntity"/>
        <table tableName="team_invitation" domainObjectName="TeamInvitationEntity"/>
        <table tableName="bed_assignment" domainObjectName="BedAssignmentEntity"/>
        <table tableName="assignment_history" domainObjectName="AssignmentHistoryEntity"/>
        <table tableName="allocation_run" domainObjectName="AllocationRunEntity"/>
        <table tableName="allocation_run_result" domainObjectName="AllocationRunResultEntity"/>
        <table tableName="audit_log" domainObjectName="AuditLogEntity"/>
    </context>
</generatorConfiguration>
