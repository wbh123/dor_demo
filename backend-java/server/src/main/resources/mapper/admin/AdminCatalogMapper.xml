<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wust.dormitory.admin.mapper.AdminCatalogMapper">
    <resultMap id="MajorCatalogResultMap"
               type="com.wust.dormitory.admin.model.persistence.MajorCatalogRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="major_code" javaType="java.lang.String"/>
            <arg column="major_name" javaType="java.lang.String"/>
            <arg column="enabled" javaType="java.lang.Boolean"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="BuildingCatalogResultMap"
               type="com.wust.dormitory.admin.model.persistence.BuildingCatalogRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="building_code" javaType="java.lang.String"/>
            <arg column="building_name" javaType="java.lang.String"/>
            <arg column="gender_restriction" javaType="java.lang.String"/>
            <arg column="education_level_scope" javaType="java.lang.String"/>
            <arg column="resident_scope" javaType="java.lang.String"/>
            <arg column="enabled" javaType="java.lang.Boolean"/>
            <arg column="campus_name" javaType="java.lang.String"/>
            <arg column="room_count" javaType="java.lang.Long"/>
            <arg column="bed_count" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <resultMap id="BuildingStaticResultMap"
               type="com.wust.dormitory.admin.model.persistence.BuildingStaticRow">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="building_code" javaType="java.lang.String"/>
            <arg column="building_name" javaType="java.lang.String"/>
            <arg column="gender_restriction" javaType="java.lang.String"/>
            <arg column="education_level_scope" javaType="java.lang.String"/>
            <arg column="resident_scope" javaType="java.lang.String"/>
            <arg column="enabled" javaType="boolean"/>
            <arg column="campus_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="FloorCatalogResultMap"
               type="com.wust.dormitory.admin.model.persistence.FloorCatalogRow">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="building_id" javaType="long"/>
            <arg column="floor_number" javaType="int"/>
            <arg column="floor_name" javaType="java.lang.String"/>
            <arg column="enabled" javaType="boolean"/>
        </constructor>
    </resultMap>

    <select id="findMajors" resultMap="MajorCatalogResultMap">
        SELECT id,
               major_code,
               major_name,
               enabled,
               created_at,
               updated_at
        FROM major
        <where>
            <if test="enabled != null">
                enabled = #{enabled}
            </if>
        </where>
        ORDER BY major_code
    </select>

    <select id="findBuildings" resultMap="BuildingCatalogResultMap">
        SELECT b.id,
               b.building_code,
               b.building_name,
               b.gender_restriction,
               b.education_level_scope,
               b.resident_scope,
               b.enabled,
               c.campus_name,
               COUNT(DISTINCT r.id) AS room_count,
               COUNT(DISTINCT CASE
                   WHEN bed.operational_status &lt;&gt; 'RETIRED' THEN bed.id
                   ELSE NULL
               END) AS bed_count
        FROM dormitory_building b
        JOIN campus c ON c.id = b.campus_id
        LEFT JOIN dormitory_floor f ON f.building_id = b.id
        LEFT JOIN room r ON r.floor_id = f.id
        LEFT JOIN bed ON bed.room_id = r.id
        GROUP BY b.id,
                 b.building_code,
                 b.building_name,
                 b.gender_restriction,
                 b.education_level_scope,
                 b.resident_scope,
                 b.enabled,
                 c.campus_name
        ORDER BY b.building_code
    </select>

    <sql id="BuildingStaticColumns">
        building.id,
        building.building_code,
        building.building_name,
        building.gender_restriction,
        building.education_level_scope,
        building.resident_scope,
        building.enabled,
        campus.campus_name
    </sql>

    <select id="findAllBuildingStatic" resultMap="BuildingStaticResultMap">
        SELECT <include refid="BuildingStaticColumns"/>
        FROM dormitory_building building
        JOIN campus ON campus.id = building.campus_id
        ORDER BY building.building_code, building.id
    </select>

    <select id="findBuildingStatic" resultMap="BuildingStaticResultMap">
        SELECT <include refid="BuildingStaticColumns"/>
        FROM dormitory_building building
        JOIN campus ON campus.id = building.campus_id
        WHERE building.id = #{buildingId}
    </select>

    <select id="findAllFloors" resultMap="FloorCatalogResultMap">
        SELECT floor.id,
               floor.building_id,
               floor.floor_number,
               floor.floor_name,
               floor.enabled
        FROM dormitory_floor floor
        ORDER BY floor.building_id, floor.floor_number, floor.id
    </select>

    <select id="findFloors" resultMap="FloorCatalogResultMap">
        SELECT floor.id,
               floor.building_id,
               floor.floor_number,
               floor.floor_name,
               floor.enabled
        FROM dormitory_floor floor
        WHERE floor.building_id = #{buildingId}
        ORDER BY floor.floor_number, floor.id
    </select>
</mapper>
