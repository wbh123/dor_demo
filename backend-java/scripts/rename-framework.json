{
  "schema_version": 1,
  "project_root": ".",
  "text": {
    "roots": [
      "pom.xml",
      "client",
      "model",
      "server",
      "starter",
      "README.md",
      "docs"
    ],
    "exclude_dirs": [
      ".git",
      "target",
      ".idea",
      ".vscode",
      "__pycache__"
    ],
    "exclude_files": [
      "scripts/rename-framework.py"
    ],
    "include_extensions": [
      ".xml",
      ".java",
      ".yaml",
      ".yml",
      ".properties",
      ".md",
      ".json"
    ],
    "include_names": [
      "Dockerfile"
    ]
  },
  "replacements": [
    {
      "from": "<groupId>com.service.demo</groupId>",
      "to": "<groupId>com.wust.dormitory</groupId>"
    },
    {
      "from": "<artifactId>ServiceDemo</artifactId>",
      "to": "<artifactId>WustDormitorySelect</artifactId>"
    },
    {
      "from": "title: ServiceDemo 接口",
      "to": "title: Example Service 接口"
    },
    {
      "from": "name: ServiceDemo",
      "to": "name: WustDormitorySelect"
    },
    {
      "from": "StartApplication",
      "to": "WustDormitorySelectApplication"
    },
    {
      "from": "com.service.demo",
      "to": "com.wust.dormitory"
    },
    {
      "from": "com/service/demo",
      "to": "com/wust/dormitory"
    },
    {
      "from": "service_demo",
      "to": "wust_dormitory"
    },
    {
      "from": "service-demo",
      "to": "wust-dormitory"
    },
    {
      "from": "ServiceDemo",
      "to": "WustDormitory"
    }
  ],
  "moves": [
    {
      "source": "server/src/main/java/com/service/demo",
      "target": "server/src/main/java/com/com/wust/dormitory/service"
    },
    {
      "source": "starter/src/main/java/com/service/demo/StartApplication.java",
      "target": "starter/src/main/java/com/wust/dormitory/service/WustDormitorySelectApplication.java"
    },
    {
      "source": "server/src/main/resources/com/service/demo",
      "target": "server/src/main/resources/com/wust/dormitory/service",
      "required": false
    }
  ],
  "build": {
    "command": "mvn clean install -DskipTests",
    "jar": "starter/target/Service.jar"
  }
}
